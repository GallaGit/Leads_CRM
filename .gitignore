# === Leads_CRM — un solo .gitignore en la raíz ===

# Dependencias
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / build / tests
.next/
out/
build/
coverage/
.turbo/
*.tsbuildinfo
next-env.d.ts
_smoke_out/
playwright-report/
test-results/

# Secretos y entorno (sí se versiona .env.example)
.env
.env.*
!.env.example
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SO / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Vercel / caches
.vercel
.cache/

# Python (skills de testing)
__pycache__/
.venv/
venv/
*.pyc

# Investigación y notas locales — no van al remoto
Nicho/
Notas/
Notas-de-ideas/

# Copia/worktree duplicada y carpeta antigua (bloqueada por el IDE; la app es Leads_CRM/)
dashboard-master/
dashboard/
